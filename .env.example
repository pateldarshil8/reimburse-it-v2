# Supabase Postgres connection strings
# DATABASE_URL: pooled connection (port 6543, add ?pgbouncer=true) — used by the app at runtime
# DIRECT_URL: direct connection (port 5432) — used by the CLI for db push/migrate
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-secret"

# Supabase Storage (private "receipts" bucket) -- used for receipt uploads.
# SUPABASE_URL is your project's API URL (Project Settings -> API).
# SUPABASE_SERVICE_ROLE_KEY is the secret service_role key from the same page --
# never expose this to the client, server-side use only.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
